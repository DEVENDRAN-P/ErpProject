# === ProductPilot AI — Environment Configuration ===
# Copy this file to .env and fill in the required values.

# --- AI / LLM Keys (optional — system uses heuristic fallback if not provided) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Database (SQLite recommended for local dev) ---
DATABASE_URL=sqlite:///./productpilot.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/productpilot

# --- JWT Security (legacy — kept for backward compatibility) ---
JWT_SECRET_KEY=replace-with-a-secure-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Frontend/Backend URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Firebase Frontend (NEXT_PUBLIC_ vars exposed to browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Backend (Admin SDK — NEVER expose to frontend) ---
# Option A: Set the three env vars below (recommended for development)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option B: Inline JSON service account key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
# Option C: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccountKey.json

# --- Optional services (comment out if not using) ---
# REDIS_URL=redis://localhost:6379/0
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j-password
