# === NexGen / ProductPilot AI — Backend Environment Configuration ===
# Configure these variables in Render / Railway / Backend Host Environment Settings.

# --- Environment Mode ---
# Set to "production" when deployed to cloud servers
ENVIRONMENT=production


# --- CORS & Frontend Connection ---
FRONTEND_URL=https://nexgenplus-erp.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# --- AI / LLM Keys (Optional — system uses heuristic rule-based extractions if omitted) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Redis Cache / Queue (Optional — only needed for background Celery workers) ---
REDIS_URL=redis://localhost:6379/0

# --- Firebase Admin SDK Credentials (Optional — needed for live token verification) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternative Firebase credential options:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=path/to/serviceAccountKey.json
