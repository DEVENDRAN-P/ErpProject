# === NexGen / ProductPilot AI — Environment Configuration ===
# Copy this file to .env or configure in your deployment platform (Render, Railway, Vercel).
# NEVER commit real credentials to Git.

# ==============================================================================
# 1. BACKEND ENVIRONMENT VARIABLES (Configure on Render / Railway / Cloud Host)
# ==============================================================================

# --- Environment Mode ---
# Set to "production" when deployed to Render/Railway
ENVIRONMENT=production

# --- Security & JWT (Required for production authentication) ---
JWT_SECRET_KEY=nexgen-prod-secret-key-2026-xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Database ---
DATABASE_URL=sqlite:///./nexgen.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# --- Frontend / Backend URLs (CORS configuration) ---
FRONTEND_URL=https://nexgenplus-erp.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# --- AI / LLM API Keys (Optional — system uses heuristic rule-based extractions if omitted) ---
# IMPORTANT: Keep on backend only — NEVER prefix with NEXT_PUBLIC_
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Redis Queue / Cache (Optional — for Celery workers) ---
REDIS_URL=redis://localhost:6379/0

# --- Firebase Backend Admin SDK (Optional — needed for live token verification) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or use inline JSON: FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Or use file path: FIREBASE_SERVICE_ACCOUNT_FILE=path/to/serviceAccountKey.json


# ==============================================================================
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure on Vercel Dashboard)
# ==============================================================================

# --- Backend Rewrites & WebSocket URLs ---
BACKEND_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com/api/ws/notifications

# --- Firebase Web App Configuration (NEXT_PUBLIC_ prefix exposes to browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
