# === NexGen — Environment Configuration ===
# Copy this file to .env and fill in the required values.
# NEVER commit .env files with real credentials.

# --- AI / LLM Keys (optional — system uses heuristic fallback if not provided) ---
# IMPORTANT: These must be backend-only. NEVER prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Database (SQLite recommended for local dev) ---
DATABASE_URL=sqlite:///./nexgen.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/nexgen

# --- JWT Security (required — must be a strong random string) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Frontend/Backend URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Environment (set to "production" in production) ---
ENVIRONMENT=development

# --- Firebase Frontend (NEXT_PUBLIC_ vars are safe to expose to browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Backend (Admin SDK — NEVER expose to frontend) ---
# Required: set these three env vars
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or use inline JSON: FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
