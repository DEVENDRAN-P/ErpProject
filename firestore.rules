rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if the authenticated user owns the resource
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ─── Users collection ────────────────────────────────────────────
    match /users/{userId} {
      // Only the user themselves can read/write their profile
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      // Prevent deletion from client (handled server-side only)
      allow delete: if false;

      // ─── Products sub-collection ─────────────────────────────────
      match /products/{productId} {
        allow read, write: if isOwner(userId);

        // ─── Attributes sub-sub-collection ───────────────────────
        match /attributes/{attributeId} {
          allow read, write: if isOwner(userId);
        }

        // ─── Versions sub-sub-collection ────────────────────────
        match /versions/{versionId} {
          allow read, write: if isOwner(userId);
        }

        // ─── Conflicts sub-sub-collection ───────────────────────
        match /conflicts/{conflictId} {
          allow read, write: if isOwner(userId);
        }

        // ─── Reviews sub-sub-collection ─────────────────────────
        match /reviews/{reviewId} {
          allow read, write: if isOwner(userId);
        }

        // ─── Documents sub-sub-collection ───────────────────────
        match /documents/{documentId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
